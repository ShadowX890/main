-- ---------------------------------------------------------------
--  fetch
--
--  Several ways because executors do not all expose the same one, and a brief
--  network hiccup is normal - one retry turns "the script is broken" back into
--  a two second wait.
-- ---------------------------------------------------------------
local function grab(url)
    local ways = {
        function() return game:HttpGet(url, true) end,
        function() return game:HttpGetAsync(url) end,
        function() return request and request({ Url = url, Method = "GET" }).Body end,
        function() return syn and syn.request
            and syn.request({ Url = url, Method = "GET" }).Body end,
    }
    for _, way in ipairs(ways) do
        local ok, body = pcall(way)
        if ok and type(body) == "string" and #body > 0 then return body end
    end
    return nil
end

-- ---------------------------------------------------------------
--  percent encoding
--
--  !! TOKEN goes into a URL, so it cannot be pasted in raw.
--  A space is the one that actually bites: a raw space ends the request line
--  in HTTP, so what happens next is decided by whichever executor the player
--  is using. Some encode it for you, some send it as is and collect a 400,
--  some drop everything after it. That is the worst kind of bug this project
--  has - it works on the machine you tested on and fails for a stranger, with
--  an error that points nowhere near the cause.
--
--  Brackets, quotes and the rest are the same story with better odds.
--
--  Encoding here removes the whole question: any token at all is safe, and
--  the Worker decodes it back before comparing. Keeping the token to letters
--  and digits is still the calmer choice, but it is no longer required.
--
--  The kept set is RFC 3986 "unreserved" - the characters every parser in the
--  chain agrees to leave alone.
-- ---------------------------------------------------------------
local function urlencode(s)
    return (s:gsub("[^%w%-%._~]", function(c)
        return string.format("%%%02X", string.byte(c))
    end))
end

local url = ENDPOINT .. "?s=" .. SCRIPT
if TOKEN ~= "" then url = url .. "&t=" .. urlencode(TOKEN) end
if LIFT then url = url .. "&lift=1" end

local src
for i = 1, 3 do
    src = grab(url)
    if src then break end
    if i < 3 then task.wait(1.5) end
end

if not src then
    show("Cannot reach the server", "Check your connection and try again.")
    return
end

-- ---------------------------------------------------------------
--  rejection or real code?
--
--  !! DO NOT test  src:sub(1, 2) == "--"
--  The real payload starts with  --[[ build xxxxxxxx ]]  which is also two
--  dashes, so that test rejects every valid response. It did exactly that once
--  already in loader-tds.lua.
--
--  Match the known rejection wording instead. The keyless path has two of its
--  own on top of the shared ones:
--      -- bad token            TOKEN here does not match KEYLESS_<SCRIPT>
--      -- no gate for X        KEYLESS_<SCRIPT> is not set at all
--  Both are config mistakes on our side, not the user's, so say so plainly
--  rather than making them think they did something wrong.
-- ---------------------------------------------------------------
local reject = src:match("^%-%-%s*(bad token[^\r\n]*)")
    or src:match("^%-%-%s*(no gate[^\r\n]*)")
    or src:match("^%-%-%s*(conflicting config[^\r\n]*)")
    or src:match("^%-%-%s*(gate not configured[^\r\n]*)")
    or src:match("^%-%-%s*(unknown script[^\r\n]*)")
    or src:match("^%-%-%s*(bad script id[^\r\n]*)")
    or src:match("^%-%-%s*(missing script id[^\r\n]*)")
    or src:match("^%-%-%s*(key rejected[^\r\n]*)")
    or src:match("^%-%-%s*(missing key[^\r\n]*)")
    or src:match("^%-%-%s*(upstream[^\r\n]*)")
    or src:match("^%-%-%s*(method not allowed[^\r\n]*)")

if reject then
    show("Server refused", reject .. "\n(this is a setup problem, tell the admin)")
    return
end

if #src < 2000 then
    show("Unexpected reply", "Only " .. #src .. " bytes.\n"
        .. src:sub(1, 150):gsub("[\r\n]+", " "))
    return
end

local fn, err = loadstring(src, "@ShadowX")
if not fn then
    show("Script failed to compile", tostring(err):sub(1, 200))
    return
end

-- ---------------------------------------------------------------
--  private environment - only when the Worker lifted the locals
--
--  !! Do not do this unconditionally.
--  Without LIFT the script still declares its own locals, so it needs nothing
--  from us, and wrapping it anyway only adds a way to break WindUI:
--  WindUI keeps its require state in _G, and handing it a fresh table makes it
--  fail with  could not reset to requiring context  followed by nil calls
--  inside WindUI itself, which points the blame at the wrong file entirely.
--
--  Reads fall through to the real globals, writes land in here.
--  pcall on purpose: if setfenv is blocked, running without it beats not
--  running at all.
-- ---------------------------------------------------------------
if LIFT then
    pcall(function()
        local realEnv = getfenv(0)
        setfenv(fn, setmetatable({}, {
            __index = function(_, k) return realEnv[k] end,
            __newindex = function(t, k, v) rawset(t, k, v) end,
        }))
    end)
end

local ok, runErr = pcall(fn)
if not ok then
    show("Script error", tostring(runErr):sub(1, 250))
end
